# ===== 抖音火花管家 Pro 全局配置（复制为 .env 后修改）=====

# 控制台端口
PORT=8020
# 监听地址：0.0.0.0 允许局域网/服务器访问，127.0.0.1 仅本机
HOST=127.0.0.1
# 控制台访问令牌（必改！登录控制台与调用 API 都要用它）
AUTH_TOKEN=change-me-to-a-long-random-string
# 时区（影响所有定时逻辑，Windows 需安装 tzdata 包，requirements 已包含）
TZ=Asia/Shanghai
# 数据目录（账号配置、浏览器档案、SQLite、日志都在这里）
DATA_DIR=./data
# 浏览器是否无头运行：true 服务器部署 / false 本机调试看得到浏览器
HEADLESS=true
# NTP 校时服务器（按顺序尝试，全部失败则回退 HTTP Date 校时，再失败用本机时钟）
NTP_SERVERS=ntp.aliyun.com,ntp.tencent.com,cn.pool.ntp.org,time.windows.com
# 日志级别 DEBUG/INFO/WARNING
LOG_LEVEL=INFO
# 最多同时打开多少个账号浏览器上下文
MAX_CONTEXTS=5
# 浏览器全局代理（可选），如 http://127.0.0.1:7890
# 风控提示：建议与日常登录城市相同的国内节点直连，海外 IP 更易触发验证
PROXY=

# ===== 通知渠道环境变量（可选，GitHub Actions 等无文件场景用）=====
# 数据文件 data/global.json 优先；同名环境变量只在对应项为空时生效
# NOTIFY_SERVERCHAN_SENDKEY=
# NOTIFY_BARK_URL=
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_WECOM_WEBHOOK=
# NOTIFY_DINGTALK_WEBHOOK=
# NOTIFY_DINGTALK_SECRET=
# NOTIFY_CUSTOM_WEBHOOK=
